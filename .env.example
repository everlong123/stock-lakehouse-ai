APP_NAME=Stock Lakehouse AI
APP_ENV=development
APP_DEBUG=true

API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=stock_lakehouse
MYSQL_USER=root
MYSQL_PASSWORD=123456

DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/stock_lakehouse

STORAGE_BACKEND=local
DATA_ROOT=data

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_BRONZE=stock-bronze
MINIO_BUCKET_SILVER=stock-silver
MINIO_BUCKET_GOLD=stock-gold
MINIO_BUCKET_MODELS=stock-models
MINIO_BUCKET_BACKTESTS=stock-backtests

USE_SPARK=false
SPARK_APP_NAME=stock-lakehouse
SPARK_MASTER=local[*]

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60

DEFAULT_SYMBOL=AAPL
DEFAULT_INTERVAL=1d
DEFAULT_LOOKBACK_DAYS=730

MODEL_DIR=data/models
RANDOM_SEED=42

TRAIN_RATIO=0.70
VALIDATION_RATIO=0.15
TEST_RATIO=0.15

LSTM_SEQUENCE_LENGTH=60
LSTM_HIDDEN_SIZE=64
LSTM_NUM_LAYERS=2
LSTM_DROPOUT=0.2
LSTM_LEARNING_RATE=0.001
LSTM_BATCH_SIZE=32
LSTM_EPOCHS=20
LSTM_PATIENCE=5

ARIMA_ORDER=5,1,0

DATA_SOURCE=sample
YFINANCE_TIMEOUT=30

LOG_LEVEL=INFO
LOG_FILE=logs/app.log

FRONTEND_VITE_API_BASE_URL=http://localhost:8000/api/v1
