APP_NAME=Stock Lakehouse AI
APP_ENV=development
APP_DEBUG=true

API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=stock_lakehouse
MYSQL_USER=root
MYSQL_PASSWORD=123456

DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/stock_lakehouse

STORAGE_BACKEND=local
DATA_ROOT=data

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_BRONZE=stock-bronze
MINIO_BUCKET_SILVER=stock-silver
MINIO_BUCKET_GOLD=stock-gold
MINIO_BUCKET_MODELS=stock-models
MINIO_BUCKET_BACKTESTS=stock-backtests

USE_SPARK=false
SPARK_APP_NAME=stock-lakehouse
SPARK_MASTER=local[*]

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60

# ── Gemini Free API (https://aistudio.google.com/apikey) ────────────────────
# Lấy free API key tại Google AI Studio. Miễn phí 60 req/min.
GEMINI_API_KEY=AIzaSyAb8RN6Ic6DWpYWtAXDsR4vWki5tSS-LG6s5LK0P9K1iHEjeLfw
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# LLM provider: "gemini" (recommended - free), "openai", hoặc "local" (offline router).
LLM_PROVIDER=gemini

DEFAULT_SYMBOL=AAPL
DEFAULT_INTERVAL=1d
DEFAULT_LOOKBACK_DAYS=730

MODEL_DIR=data/models
RANDOM_SEED=42

TRAIN_RATIO=0.70
VALIDATION_RATIO=0.15
TEST_RATIO=0.15

LSTM_SEQUENCE_LENGTH=60
LSTM_HIDDEN_SIZE=64
LSTM_NUM_LAYERS=2
LSTM_DROPOUT=0.2
LSTM_LEARNING_RATE=0.001
LSTM_BATCH_SIZE=32
LSTM_EPOCHS=20
LSTM_PATIENCE=5

ARIMA_ORDER=5,1,0

DATA_SOURCE=yfinance
# Available providers:
#   sample         -> Synthetic CSV/Parquet (no network)
#   yfinance       -> yfinance package (preferred for historical OHLCV)
#   yfinance_direct-> Direct HTTP client (no extra dependency)
#   finnhub        -> Finnhub Free tier (60 req/min; historical OHLCV + news)
#   alpha_vantage  -> Alpha Vantage (free tier; daily/intraday)
#   web_scraper    -> Yahoo Finance via HTTP + CafeF
YFINANCE_TIMEOUT=30
ALPHA_VANTAGE_API_KEY=
# Finnhub Free API key (https://finnhub.io/) - $0 plan used for historical + WS streaming
FINNHUB_API_KEY=
FINNHUB_WEBHOOK_SECRET=
# Finnhub WebSocket throttling (Free tier caps at ~50 symbols/connection,
# ~50 msgs/sec). Use a small symbol set when streaming live.
FINNHUB_WS_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA,NVDA,META,AMD
FINNHUB_WS_PING_INTERVAL=25

LOG_LEVEL=INFO
LOG_FILE=logs/app.log

FRONTEND_VITE_API_BASE_URL=http://localhost:8000/api/v1
