# Local Development Override
# =========================
# File này override các biến trong .env khi chạy LOCAL (không qua Docker).
# Cách dùng:
#
#   1. Copy file này thành .env.local (cùng thư mục với .env)
#   2. Sửa các giá trị cho phù hợp với máy bạn
#   3. Backend tự động load .env.local (ưu tiên cao hơn .env) khi APP_ENV=development
#
# HOẶC dùng shell env trước khi chạy uvicorn:
#   $env:MYSQL_HOST="127.0.0.1"; $env:KAFKA_BOOTSTRAP_SERVERS="127.0.0.1:9092"
#   python -m uvicorn app.main:app --reload
#
# Local dev dùng các dịch vụ CHẠY TRÊN MÁY (port mặc định):
#   - MySQL:   127.0.0.1:3306  (hoặc 127.0.0.1:3307 nếu Docker compose cũng chạy)
#   - MinIO:   127.0.0.1:9000  (console :9001)
#   - Kafka:   127.0.0.1:9092  (PLAINTEXT local) - hoặc 127.0.0.1:9094 (EXTERNAL listener)
#   - Iceberg: 127.0.0.1:8181  (chỉ cần nếu USE_ICEBERG=true)
#
# Nếu chưa cài Kafka/MinIO trên local, đặt USE_KAFKA=false để backend chạy được
# (vẫn demo được REST API, training, predict; chỉ thiếu phần streaming real-time).

# ── Database (local MySQL) ───────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=stock_lakehouse
MYSQL_USER=root
MYSQL_PASSWORD=123456
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/stock_lakehouse

# ── Object storage (local MinIO nếu có, fallback filesystem) ────────────────
STORAGE_BACKEND=local
DATA_ROOT=data
# Bật MinIO local nếu đã cài:
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin

# ── Kafka (tắt nếu chưa cài local) ─────────────────────────────────────────
USE_KAFKA=false
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# Bật Kafka local nếu đã cài:
# USE_KAFKA=true
# KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9094

# ── CORS (cho Vite :5173) ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Streaming flags (mặc định off cho local, tiết kiệm CPU) ────────────────
CRAWL_ENABLED=false
US_EOD_POLLER_ENABLED=false
US_REST_POLLER_ENABLED=false
VN_WS_ENABLED=false  # Tắt vì SSI websocket cần internet ổn định

# ── Auto-refresh ─────────────────────────────────────────────────────────────
# Số worker fetch (I/O-bound: HTTP + MinIO).
AUTO_REFRESH_WORKERS=8

# Số rebuild Silver/Gold chạy SONG SONG.
#
# WHY THIS IS SMALL: mỗi rebuild chạy trong một CHILD PROCESS riêng (xem
# app/core/heavy_worker.py) và mỗi child giữ nguyên lịch sử của 1 mã trong
# RAM (~700 MB). Máy này KHÔNG có pagefile, nên commit limit = RAM thật
# (31.8 GB). Khi commit chạm trần, Windows giết tiến trình thay vì swap -
# và chính các worker đó là nạn nhân (Event 2004 "low virtual memory
# condition" trong Windows Event Log).
#
# Giảm từ 12 xuống 3: refresh chậm đi một chút nhưng máy không còn crash.
AUTO_REFRESH_REBUILD_WORKERS=3

# ── Memory budget cho CPU-bound job pool ─────────────────────────────────────
# Mỗi worker được tính là ~700 MB (import pandas/pyarrow ~130 MB + lịch sử
# mã trong DataFrame ~400 MB + cột indicator ~150 MB).
HEAVY_WORKER_MEMORY_MB=700

# RAM tối thiểu phải còn lại cho Windows (Cursor, trình duyệt, AV).
# Nếu free RAM thấp hơn ngưỡng này thì pool tự thu nhỏ lại.
HEAVY_RESERVE_FOR_HOST_MB=4096

# Số worker tối đa của pool tương tác (agent) và pool background (refresh).
# Cả hai đều còn bị clamp thêm theo RAM thực còn trống.
HEAVY_POOL_SIZE=2
HEAVY_BACKGROUND_POOL_SIZE=3
