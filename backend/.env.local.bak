# Local (non-Docker) overrides for Windows host development.
#
# Why this file exists: backend/.env points every dependency at the Docker
# Compose service names (mysql, minio, kafka). Those hostnames only resolve
# inside the compose network. When you run uvicorn directly on Windows, the
# same infra is reachable at different hosts/ports:
#
#   MySQL  -> 127.0.0.1:3307   (compose publishes "3307:3306")
#   MinIO  -> 127.0.0.1:9000   (compose uses network_mode: host)
#   Kafka  -> 127.0.0.1:9092   (compose publishes "9092:9092")
#
# ── Direct published ports (relay no longer needed) ──────────────────────────
# The 13307 / 19000 relay (backend/scripts/relay_ports.py) existed because
# Windows could not open TCP to the WSL2 VM at all: 127.0.0.1:3307 and
# 127.0.0.1:9000 came back WinError 10061 while `ss -tln` inside the VM
# showed the listeners, and the WSL firewall reported
# DefaultInboundAction=Block (changing it needs Administrator).
#
# That is no longer the case. Verified 2026-10-27 from Windows:
#   3307 (MySQL)  TCP OK, pymysql connect OK
#   9000 (MinIO) HTTP 200 on /minio/health/live
#   9092 (Kafka) TCP OK
#   8181 (Iceberg REST) HTTP 200
# The WSL2 localhost-forwarding path works now, so the relay is unnecessary
# and this file points straight at the published ports.
#
# If a future WSL upgrade breaks the forwarding again, run the relay and
# change these back to 13307 / 19000:
#   wsl -d Ubuntu-24.04 -u root -- python3 backend/scripts/relay_ports.py
#
# Loaded automatically by app/core/config.py AFTER .env, so values here win.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3307/stock_lakehouse

MINIO_ENDPOINT=127.0.0.1:9000

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# ── Local dev: keep the box responsive ─────────────────────────────────────
# Off for local runs so uvicorn doesn't spend all its time re-fetching every
# symbol in GLOBAL_SYMBOLS (958) on boot, then every 6h. The REST API reads
# the existing Bronze/Silver/Gold data either way — only the proactive
# background fetching stops. Set any of these back to true on the machine
# where you actually want fresh data.
#
# 2026-10-31: AUTO_REFRESH_ENABLED was flipped back to true. With it off the
# lakehouse was never refreshed by the API process, so the only thing that
# could bring new bars in was the scheduled task — and that task fires at
# 06:00 while nothing is running yet, so every run failed and the UI kept
# serving data that was days old. The task now waits for the API to come up
# (see backend/daily_refresh.py), so both paths are safe to leave enabled.
USE_KAFKA=false
CRAWL_ENABLED=false
AUTO_REFRESH_ENABLED=true
# One pass over GLOBAL_SYMBOLS + VN_SYMBOLS (~1012 tickers) touches every
# provider, so give it room. The service sleeps in 5s slices and the
# HTTP-triggered run is fire-and-forget, so this does not block the API.
AUTO_REFRESH_INTERVAL_SECONDS=21600
AUTO_REFRESH_WORKERS=8
# A rebuild reads the symbol's whole history and rewrites every month
# partition, so it is MinIO-I/O bound rather than CPU bound. Four workers
# left the box at ~20% CPU while the backlog crawled; twelve keeps the
# connection pool busy without starving the HTTP read path (the pool is
# sized at 64 in app/lakehouse/minio_storage.py).
AUTO_REFRESH_REBUILD_WORKERS=12
# Refresh at most once per symbol per calendar day: EOD bars only change
# once a day, and a shorter window would re-fetch ~1000 tickers for nothing.
AUTO_REFRESH_SKIP_IF_FRESH_HOURS=20
WARM_LAYER_COUNTS_ON_START=false